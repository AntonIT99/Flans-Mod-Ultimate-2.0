<code_scheme name="Flans Mod Ultimate" version="173">
    <option name="AUTODETECT_INDENTS" value="false" />

    <JavaCodeStyleSettings>
        <!-- Never automatically collapse imports into * imports. -->
        <option name="CLASS_COUNT_TO_USE_IMPORT_ON_DEMAND" value="999" />
        <option name="NAMES_COUNT_TO_USE_IMPORT_ON_DEMAND" value="999" />

        <option name="IMPORT_LAYOUT_TABLE">
            <value>
                <!-- Project, libraries, Mojang, Forge, Lombok, etc. -->
                <package name="" withSubpackages="true" static="false" />

                <emptyLine />

                <!-- Minecraft kept as its own visual group. -->
                <package name="net.minecraft" withSubpackages="true" static="false" />

                <emptyLine />

                <!-- JDK -->
                <package name="javax" withSubpackages="true" static="false" />
                <package name="java" withSubpackages="true" static="false" />

                <emptyLine />

                <!-- Static imports last. -->
                <package name="" withSubpackages="true" static="true" />
            </value>
        </option>
    </JavaCodeStyleSettings>

    <codeStyleSettings language="JAVA">
        <!-- Current code generally fits inside this while allowing complex signatures. -->
        <option name="RIGHT_MARGIN" value="160" />

        <!-- Allman braces. -->
        <option name="BRACE_STYLE" value="2" />
        <option name="CLASS_BRACE_STYLE" value="2" />
        <option name="METHOD_BRACE_STYLE" value="2" />

        <option name="ELSE_ON_NEW_LINE" value="true" />
        <option name="WHILE_ON_NEW_LINE" value="true" />
        <option name="CATCH_ON_NEW_LINE" value="true" />
        <option name="FINALLY_ON_NEW_LINE" value="true" />

        <option name="ENUM_CONSTANTS_WRAP" value="2" />
        <option name="FIELD_ANNOTATION_WRAP" value="0" />

        <indentOptions>
            <option name="INDENT_SIZE" value="4" />
            <option name="CONTINUATION_INDENT_SIZE" value="4" />
            <option name="TAB_SIZE" value="4" />
            <option name="USE_TAB_CHARACTER" value="false" />
        </indentOptions>

        <arrangement>
            <groups>
                <group>
                    <type>GETTERS_AND_SETTERS</type>
                    <order>KEEP</order>
                </group>
                <group>
                    <type>OVERRIDDEN_METHODS</type>
                    <order>KEEP</order>
                </group>
                <group>
                    <type>DEPENDENT_METHODS</type>
                    <order>DEPTH_FIRST</order>
                </group>
            </groups>
        </arrangement>
    </codeStyleSettings>

    <codeStyleSettings language="JSON">
        <indentOptions>
            <option name="INDENT_SIZE" value="4" />
            <option name="CONTINUATION_INDENT_SIZE" value="4" />
            <option name="TAB_SIZE" value="4" />
            <option name="USE_TAB_CHARACTER" value="false" />
        </indentOptions>
    </codeStyleSettings>
</code_scheme>
